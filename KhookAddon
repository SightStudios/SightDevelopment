local function createToggle(parent, name, default, callback)
    local toggleFrame = Instance.new("Frame")
    toggleFrame.Size = UDim2.new(1, -14, 0, 32)
    toggleFrame.BackgroundColor3 = Theme.DarkContainer
    toggleFrame.BorderSizePixel = 0
    toggleFrame.Parent = parent
    Instance.new("UICorner", toggleFrame).CornerRadius = UDim.new(0, 2)
    
    local tStroke = Instance.new("UIStroke", toggleFrame)
    tStroke.Color = Theme.Border
    tStroke.Thickness = 1
    
    local toggleLabel = Instance.new("TextLabel")
    toggleLabel.Size = UDim2.new(1, -65, 1, 0)
    toggleLabel.Position = UDim2.new(0, 10, 0, 0)
    toggleLabel.BackgroundTransparency = 1
    toggleLabel.Text = name
    toggleLabel.TextColor3 = Theme.TextMain
    toggleLabel.TextSize = 11
    toggleLabel.Font = Enum.Font.RobotoMono
    toggleLabel.TextXAlignment = Enum.TextXAlignment.Left
    toggleLabel.Parent = toggleFrame
    
    local toggleButton = Instance.new("TextButton")
    toggleButton.Size = UDim2.new(0, 30, 0, 14)
    toggleButton.Position = UDim2.new(1, -40, 0.5, -7)
    toggleButton.BackgroundColor3 = default and Theme.BorderActive or Theme.LightContainer
    toggleButton.Text = ""
    toggleButton.BorderSizePixel = 0
    toggleButton.Parent = toggleFrame
    Instance.new("UICorner", toggleButton).CornerRadius = UDim.new(0, 1)
    
    local tbStroke = Instance.new("UIStroke", toggleButton)
    tbStroke.Color = default and Theme.BorderActive or Theme.Border
    tbStroke.Thickness = 1
    
    local toggleDot = Instance.new("Frame")
    toggleDot.Size = UDim2.new(0, 10, 0, 10)
    toggleDot.Position = default and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
    toggleDot.BackgroundColor3 = Theme.TextMain
    toggleDot.BorderSizePixel = 0
    toggleDot.Parent = toggleButton
    Instance.new("UICorner", toggleDot).CornerRadius = UDim.new(0, 1)
    
    local toggled = default or false
    local selfUpdating = false
    
    local function update(state)
        if selfUpdating then return end
        toggled = state
        local color = toggled and Theme.BorderActive or Theme.LightContainer
        local strokeColor = toggled and Theme.BorderActive or Theme.Border
        local pos = toggled and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
        TweenService:Create(toggleButton, TweenInfo.new(0.1), {BackgroundColor3 = color}):Play()
        TweenService:Create(tbStroke, TweenInfo.new(0.1), {Color = strokeColor}):Play()
        TweenService:Create(toggleDot, TweenInfo.new(0.1), {Position = pos}):Play()
        if callback then callback(toggled) end
    end
    
    toggleButton.MouseButton1Click:Connect(function()
        update(not toggled)
    end)
    
    return {
        Set = function(s)
            selfUpdating = true
            toggled = s
            local color = toggled and Theme.BorderActive or Theme.LightContainer
            local strokeColor = toggled and Theme.BorderActive or Theme.Border
            local pos = toggled and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
            toggleButton.BackgroundColor3 = color
            tbStroke.Color = strokeColor
            toggleDot.Position = pos
            selfUpdating = false
        end,
        Get = function() return toggled end
    }
end

local function createSlider(parent, name, min, max, default, callback)
    local sliderFrame = Instance.new("Frame")
    sliderFrame.Size = UDim2.new(1, -14, 0, 46)
    sliderFrame.BackgroundColor3 = Theme.DarkContainer
    sliderFrame.BorderSizePixel = 0
    sliderFrame.Parent = parent
    Instance.new("UICorner", sliderFrame).CornerRadius = UDim.new(0, 2)
    
    local sStroke = Instance.new("UIStroke", sliderFrame)
    sStroke.Color = Theme.Border
    sStroke.Thickness = 1
    
    local sliderLabel = Instance.new("TextLabel")
    sliderLabel.Size = UDim2.new(1, -70, 0, 20)
    sliderLabel.Position = UDim2.new(0, 10, 0, 4)
    sliderLabel.BackgroundTransparency = 1
    sliderLabel.Text = name
    sliderLabel.TextColor3 = Theme.TextMain
    sliderLabel.TextSize = 11
    sliderLabel.Font = Enum.Font.RobotoMono
    sliderLabel.TextXAlignment = Enum.TextXAlignment.Left
    sliderLabel.Parent = sliderFrame
    
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0, 50, 0, 20)
    valueLabel.Position = UDim2.new(1, -60, 0, 4)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(default)
    valueLabel.TextColor3 = Theme.TextDark
    valueLabel.TextSize = 11
    valueLabel.Font = Enum.Font.RobotoMono
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = sliderFrame
    
    local sliderBar = Instance.new("Frame")
    sliderBar.Size = UDim2.new(1, -20, 0, 4)
    sliderBar.Position = UDim2.new(0, 10, 0, 30)
    sliderBar.BackgroundColor3 = Theme.LightContainer
    sliderBar.BorderSizePixel = 0
    sliderBar.Parent = sliderFrame
    Instance.new("UICorner", sliderBar).CornerRadius = UDim.new(0, 1)
    
    local sbStroke = Instance.new("UIStroke", sliderBar)
    sbStroke.Color = Theme.Border
    sbStroke.Thickness = 1
    
    local sliderFill = Instance.new("Frame")
    sliderFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    sliderFill.BackgroundColor3 = Theme.BorderActive
    sliderFill.BorderSizePixel = 0
    sliderFill.Parent = sliderBar
    Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(0, 1)
    
    local sliderDot = Instance.new("Frame")
    sliderDot.Size = UDim2.new(0, 6, 0, 10)
    sliderDot.Position = UDim2.new((default - min) / (max - min), -3, 0.5, -5)
    sliderDot.BackgroundColor3 = Theme.TextMain
    sliderDot.BorderSizePixel = 0
    sliderDot.Parent = sliderBar
    Instance.new("UICorner", sliderDot).CornerRadius = UDim.new(0, 1)
    
    local sdStroke = Instance.new("UIStroke", sliderDot)
    sdStroke.Color = Theme.Border
    sdStroke.Thickness = 1
    
    local currentValue = default
    local dragging = false
    
    local function updateSlider(input)
        local relativePos = math.clamp((input.Position.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X, 0, 1)
        currentValue = math.floor(min + (max - min) * relativePos)
        valueLabel.Text = tostring(currentValue)
        sliderFill.Size = UDim2.new(relativePos, 0, 1, 0)
        sliderDot.Position = UDim2.new(relativePos, -3, 0.5, -5)
        if callback then callback(currentValue) end
    end
    
    sliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateSlider(input)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    return {
        Set = function(val)
            currentValue = math.clamp(val, min, max)
            local percent = (currentValue - min) / (max - min)
            valueLabel.Text = tostring(currentValue)
            sliderFill.Size = UDim2.new(percent, 0, 1, 0)
            sliderDot.Position = UDim2.new(percent, -3, 0.5, -5)
            if callback then callback(currentValue) end
        end,
        Get = function() return currentValue end
    }
end

