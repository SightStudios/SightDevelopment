    optionsFrame.Position = UDim2.new(0, 0, 0, 32)
    optionsFrame.BackgroundColor3 = Theme.Sidebar
    optionsFrame.BorderSizePixel = 0
    optionsFrame.Parent = dropdownFrame
    
    local optionsList = Instance.new("UIListLayout")
    optionsList.Parent = optionsFrame
    
    local opened = false
    local selectedOption = default or options[1]
    
    local function toggleDropdown()
        opened = not opened
        local targetFrameHeight = opened and (32 + (#options * 24)) or 32
        local targetOptionsHeight = opened and (#options * 24) or 0
        
        TweenService:Create(dropdownFrame, TweenInfo.new(0.12), {Size = UDim2.new(1, -14, 0, targetFrameHeight)}):Play()
        TweenService:Create(optionsFrame, TweenInfo.new(0.12), {Size = UDim2.new(1, 0, 0, targetOptionsHeight)}):Play()
        
        task.wait(0.12)
        if parent:IsA("ScrollingFrame") then
            parent.CanvasSize = UDim2.new(0, 0, 0, parent.UIListLayout.AbsoluteContentSize.Y + 40)
        end
    end
    
    for _, option in ipairs(options) do
        local optionButton = Instance.new("TextButton")
        optionButton.Size = UDim2.new(1, 0, 0, 24)
        optionButton.BackgroundColor3 = Theme.Sidebar
        optionButton.Text = "  " .. option
