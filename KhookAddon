        optionButton.BorderSizePixel = 0
        optionButton.TextXAlignment = Enum.TextXAlignment.Left
        optionButton.Parent = optionsFrame
        
        optionButton.MouseButton1Click:Connect(function()
            selectedOption = option
            selectedText.Text = option
            toggleDropdown()
            if callback then callback(option) end
        end)
    end
    
    local hitButton = Instance.new("TextButton")
    hitButton.Size = UDim2.new(1, 0, 0, 32)
    hitButton.BackgroundTransparency = 1
    hitButton.Text = ""
    hitButton.Parent = dropdownFrame
    hitButton.MouseButton1Click:Connect(toggleDropdown)
    
    return {
        Set = function(val)
            selectedOption = val
            selectedText.Text = val
            if callback then callback(val) end
        end,
        Get = function() return selectedOption end
    }
end

