function Protection:RegisterGame(data)
    Games[#Games + 1] = data
    self:RefreshGameList()
end

function Protection:RefreshGameList()
    for _, child in pairs(self.GameScroll:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    local sorted = {}
    for _, g in pairs(Games) do
        table.insert(sorted, g)
    end
    table.sort(sorted, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)

    local searchText = self.SearchBar.Text:lower()

    local order = 0
    for _, g in pairs(sorted) do
        if searchText == "" or g.Name:lower():find(searchText, 1, true) then
            order = order + 1
            self:CreateGameEntry(g, order)
        end
    end
end

