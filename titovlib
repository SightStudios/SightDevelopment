function Protection:SwitchTab(name, instant)
    if self.CurrentTab == name and not instant then
        return
    end

    local prevTab = self.CurrentTab == "Loader" and self.LoaderTab or self.GameTab
    local newTab = name == "Loader" and self.LoaderTab or self.GameTab
    local prevButton = self.CurrentTab == "Loader" and self.LoaderButton or self.GameButton
    local newButton = name == "Loader" and self.LoaderButton or self.GameButton

    Tween(prevButton, {TextColor3 = Color3.fromRGB(150, 150, 155)}, 0.2):Play()
    local prevStroke = prevButton:FindFirstChildOfClass("UIStroke")
    Tween(prevStroke, {Transparency = 1, Thickness = 0}, 0.2):Play()

    Tween(newButton, {TextColor3 = Color3.fromRGB(255, 255, 255)}, 0.2):Play()
    local newStroke = newButton:FindFirstChildOfClass("UIStroke")
    Tween(newStroke, {Transparency = 0, Color = Color3.fromRGB(255, 255, 255), Thickness = 1}, 0.2):Play()

    self.CurrentTab = name

    if instant then
        prevTab.Position = UDim2.new(name == "Loader" and 1 or -1, 0, 0, 0)
        newTab.Position = UDim2.new(0, 0, 0, 0)
        return
    end

    local direction = name == "Game" and -1 or 1
    newTab.Position = UDim2.new(-direction, 0, 0, 0)

    Tween(prevTab, {Position = UDim2.new(direction, 0, 0, 0)}, 0.35, Enum.EasingStyle.Quint):Play()
    Tween(newTab, {Position = UDim2.new(0, 0, 0, 0)}, 0.35, Enum.EasingStyle.Quint):Play()
end

