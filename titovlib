        Position = UDim2.new(0.5, -115, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = Color3.fromRGB(28, 28, 32),
        BorderSizePixel = 0,
        ZIndex = 10,
        ClipsDescendants = true
    }, self.MainFrame)
    Create("UICorner", {CornerRadius = UDim.new(0, 8)}, LogFrame)
    Create("UIStroke", {Color = Color3.fromRGB(255, 255, 255), Thickness = 1, Transparency = 0.85}, LogFrame)

    Create("TextLabel", {
        Size = UDim2.new(1, -40, 0, 24),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = script.Name,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 10
    }, LogFrame)

    local CloseButton = Create("TextButton", {
        Size = UDim2.new(0, 22, 0, 22),
        Position = UDim2.new(1, -30, 0, 8),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        Text = "X",
        TextColor3 = Color3.fromRGB(20, 20, 24),
        TextSize = 11,
        AutoButtonColor = false,
        ZIndex = 10
    }, LogFrame)
    Create("UICorner", {CornerRadius = UDim.new(0, 5)}, CloseButton)

    local LogScroll = Create("ScrollingFrame", {
        Size = UDim2.new(1, -16, 1, -42),
        Position = UDim2.new(0, 8, 0, 36),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255),
        ScrollBarImageTransparency = 0.7,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ZIndex = 10
    }, LogFrame)
    Create("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 4)
    }, LogScroll)
    Create("UIPadding", {
        PaddingRight = UDim.new(0, 4)
    }, LogScroll)

    if script.UpdateLog then
        for i, entry in ipairs(script.UpdateLog) do
            Create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                Text = entry.Version .. " — " .. entry.Notes,
                TextColor3 = Color3.fromRGB(195, 195, 200),
                TextSize = 11,
                TextWrapped = true,
                TextXAlignment = Enum.TextXAlignment.Left,
                LineHeight = 1.2,
                ZIndex = 10,
                LayoutOrder = i
            }, LogScroll)
        end
    end

    local targetHeight = math.clamp(60 + (#(script.UpdateLog or {}) * 28), 90, 200)

    Tween(Overlay, {BackgroundTransparency = 0.4}, 0.25):Play()
    Tween(LogFrame, {Size = UDim2.new(0, 230, 0, targetHeight)}, 0.3, Enum.EasingStyle.Back):Play()

    local function CloseLog()
        Tween(Overlay, {BackgroundTransparency = 1}, 0.2):Play()
        Tween(LogFrame, {Size = UDim2.new(0, 230, 0, 0)}, 0.2):Play()
        task.delay(0.22, function()
            Overlay:Destroy()
            LogFrame:Destroy()
            self.LogFrame = nil
            self.LogOverlay = nil
        end)
    end

    CloseButton.MouseButton1Click:Connect(CloseLog)
    Overlay.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            CloseLog()
        end
    end)

    self.LogFrame = LogFrame
    self.LogOverlay = Overlay
end

return Protection
