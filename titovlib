function Protection:LoadGame(gameId)
    local found
    for _, g in pairs(Games) do
        if tostring(g.GameId) == tostring(gameId) then
            found = g
            break
        end
    end

    for _, child in pairs(self.LoaderScroll:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    if not found then
        self.GameLabel.Text = "Game: Unsupported"
        return
    end

    self.GameLabel.Text = "Game: " .. found.Name .. " (" .. tostring(found.GameId) .. ")"

    for i, script in ipairs(found.Scripts) do
        self:CreateScriptEntry(script, i)
    end
end

