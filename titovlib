function Protection:SetActiveTabStyle(button, stroke, active)
    if active then
        Tween(button, {TextColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.9}, 0.2):Play()
        Tween(stroke, {Transparency = 0.5}, 0.2):Play()
    else
        Tween(button, {TextColor3 = Color3.fromRGB(150, 150, 156), BackgroundTransparency = 1}, 0.2):Play()
        Tween(stroke, {Transparency = 1}, 0.2):Play()
    end
end

function Protection:SwitchTab(name, instant)
    if self.CurrentTab == name and not instant then
        return
    end

    local prevTab = self.CurrentTab == "Loader" and self.LoaderTab or self.GameTab
    local newTab = name == "Loader" and self.LoaderTab or self.GameTab
    local prevButton = self.CurrentTab == "Loader" and self.LoaderButton or self.GameButton
    local newButton = name == "Loader" and self.LoaderButton or self.GameButton
    local prevStroke = self.CurrentTab == "Loader" and self.LoaderStroke or self.GameStroke
    local newStroke = name == "Loader" and self.LoaderStroke or self.GameStroke

    self:SetActiveTabStyle(prevButton, prevStroke, false)
    self:SetActiveTabStyle(newButton, newStroke, true)

    self.CurrentTab = name

    if instant then
        prevTab.Position = UDim2.new(name == "Loader" and 1 or -1, 0, 0, 0)
        newTab.Position = UDim2.new(0, 0, 0, 0)
        return
    end

    local direction = name == "Game" and -1 or 1
    newTab.Position = UDim2.new(-direction, 0, 0, 0)
    newTab.Visible = true

    Tween(prevTab, {Position = UDim2.new(direction, 0, 0, 0)}, 0.4, Enum.EasingStyle.Quint):Play()
    Tween(newTab, {Position = UDim2.new(0, 0, 0, 0)}, 0.4, Enum.EasingStyle.Quint):Play()
end

